#include <Wire.h>
#include <Adafruit_MPU6050.h>
#include <Adafruit_Sensor.h>
#include <TinyGPS++.h>

Adafruit_MPU6050 mpu;
TinyGPSPlus gps;

// Arduino Mega hardware serial connections
// GPS:  TX -> RX1 (19)
// GSM:  TX -> RX2 (17)

#define BUZZER 8
#define CANCEL_BUTTON 7

// Change this to your emergency contact number
String phoneNumber = "+919876543210";

// Accident detection threshold in m/s^2
float impactThreshold = 25.0;

// Alert countdown
const unsigned long alertDelay = 15000;

bool accidentDetected = false;

double latitude = 0;
double longitude = 0;

void setup() {
  Serial.begin(9600);

  Serial1.begin(9600); // GPS
  Serial2.begin(9600); // GSM

  pinMode(BUZZER, OUTPUT);
  pinMode(CANCEL_BUTTON, INPUT_PULLUP);

  digitalWrite(BUZZER, LOW);

  // Initialize MPU6050
  if (!mpu.begin()) {
    Serial.println("MPU6050 not found!");
    while (1) {
      delay(100);
    }
  }

  mpu.setAccelerometerRange(
    MPU6050_RANGE_8_G
  );

  mpu.setGyroRange(
    MPU6050_RANGE_500_DEG
  );

  mpu.setFilterBandwidth(
    MPU6050_BAND_21_HZ
  );

  Serial.println("Smart Helmet Started");

  delay(2000);

  Serial2.println("AT");
  delay(1000);

  Serial2.println("AT+CMGF=1");
  delay(1000);
}

void loop() {

  // Read GPS data
  while (Serial1.available()) {
    gps.encode(Serial1.read());
  }

  // Read MPU6050 data
  sensors_event_t accel;
  sensors_event_t gyro;
  sensors_event_t temp;

  mpu.getEvent(&accel, &gyro, &temp);

  // Calculate acceleration magnitude
  float totalAcceleration = sqrt(
    accel.acceleration.x * accel.acceleration.x +
    accel.acceleration.y * accel.acceleration.y +
    accel.acceleration.z * accel.acceleration.z
  );

  Serial.print("Acceleration: ");
  Serial.println(totalAcceleration);

  // Detect sudden impact
  if (totalAcceleration > impactThreshold &&
      !accidentDetected) {

    accidentDetected = true;

    Serial.println("ACCIDENT DETECTED!");

    digitalWrite(BUZZER, HIGH);

    // Wait for rider to cancel false alarm
    unsigned long startTime = millis();

    while (millis() - startTime < alertDelay) {

      while (Serial1.available()) {
        gps.encode(Serial1.read());
      }

      // Button pressed = cancel alert
      if (digitalRead(CANCEL_BUTTON) == LOW) {

        Serial.println("Accident Alert Cancelled");

        digitalWrite(BUZZER, LOW);

        accidentDetected = false;

        delay(500);
        return;
      }

      delay(50);
    }

    digitalWrite(BUZZER, LOW);

    // Get GPS coordinates
    if (gps.location.isValid()) {

      latitude = gps.location.lat();
      longitude = gps.location.lng();

    } else {

      latitude = 0;
      longitude = 0;
    }

    // Send emergency message
    sendEmergencySMS();

    // Make emergency phone call
    makeEmergencyCall();

    Serial.println("Emergency Alert Sent");
  }

  delay(100);
}

// Send SMS
void sendEmergencySMS() {

  Serial2.println("AT+CMGF=1");
  delay(1000);

  Serial2.print("AT+CMGS=\"");
  Serial2.print(phoneNumber);
  Serial2.println("\"");

  delay(1000);

  Serial2.println("EMERGENCY! Accident detected.");

  if (latitude != 0 && longitude != 0) {

    Serial2.print("Location: https://maps.google.com/?q=");
    Serial2.print(latitude, 6);
    Serial2.print(",");
    Serial2.println(longitude, 6);

  } else {

    Serial2.println("GPS location unavailable.");
  }

  Serial2.write(26); // CTRL+Z to send SMS

  delay(5000);
}

// Make emergency call
void makeEmergencyCall() {

  Serial2.print("ATD");
  Serial2.print(phoneNumber);
  Serial2.println(";");

  delay(20000);

  Serial2.println("ATH"); // End call
  delay(1000);
}